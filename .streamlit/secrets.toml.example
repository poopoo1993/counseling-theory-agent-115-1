# Copy to .streamlit/secrets.toml (gitignored). Do not commit real secrets.
# Local demo can omit Sheets and use sqlite_path below.
# Streamlit Cloud: set SPREADSHEET_ID, GOOGLE_SERVICE_ACCOUNT_JSON, and REQUIRE_SHEETS=true
# in App secrets (not this file) so reboot does not wipe login or transcripts.

[app]
title = "諮商理論技巧訓練 Agent"
timezone = "Asia/Taipei"
model_name = "gemini-flash-latest"
prompt_version = "theory-dialogue-v1.6"
local_demo_mode = true
sqlite_path = "data/app.sqlite"
participant_salt = "replace-with-a-long-random-salt"
# Gemini 2.5 Flash 免費額度（RPM/RPD/TPM 任一額滿即 429）
# gemini_free_rpm = 10
# gemini_free_rpd = 250
# gemini_free_tpm = 250000

[auth]
otp_ttl_seconds = 600
teacher_emails = ["teacher@hcu.edu.tw", "poopoo1993@gmail.com"]
login_allowlist = ["teacher@hcu.edu.tw", "student@hcu.edu.tw", "poopoo1993@gmail.com"]

[smtp]
host = "smtp.gmail.com"
port = 587
sender_email = "your-sender@gmail.com"
app_password = "your-gmail-app-password"
